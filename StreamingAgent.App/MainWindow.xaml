<Window x:Class="StreamingAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StreamingAgent.App"
        mc:Ignorable="d"
        Title="StreamingAgent Controller" Height="300" Width="480">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Region" Grid.Row="0" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical">
                <Button Content="Select Region" Width="140" Click="OnSelectRegionClick" Margin="0,0,0,4"/>
                <TextBlock x:Name="RegionText" Text="No region selected"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Capture" Grid.Row="1" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Start" Width="80" Click="OnStartClick" Margin="0,0,4,0"/>
                    <Button Content="Stop" Width="80" Click="OnStopClick" Margin="0,0,4,0"/>
                    <Button Content="Show Mirror" Width="100" Click="OnShowMirrorClick" Margin="0,0,4,0"/>
                    <Button Content="Hide Mirror" Width="100" Click="OnHideMirrorClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FPS" Width="40" VerticalAlignment="Center"/>
                    <Slider x:Name="FpsSlider" Minimum="10" Maximum="60" Value="60" Width="200" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FpsValueText" Text="60" Width="40"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="ShowCursorCheckBox" Content="Show cursor in capture" IsChecked="True"/>
                    <Button Content="Keybinds..." Width="90" Margin="12,0,0,0" Click="OnKeybindsClick"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <TextBlock x:Name="StatusText" Text="Idle" Margin="0,0,0,4" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8">
                1. Click "Select Region" and drag your streaming area.
                2. Adjust FPS, then click "Start".
                3. In Discord, choose the "Streaming Region" window and enable sound.
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
