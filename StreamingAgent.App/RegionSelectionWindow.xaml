<Window x:Class="StreamingAgent.App.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Title="Select Region">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <Rectangle x:Name="SelectionRectangle"
                   Stroke="DeepSkyBlue"
                   StrokeThickness="2"
                   Fill="#3300BFFF"
                   Visibility="Collapsed"/>
        <TextBlock Text="Click and drag to select streaming region. Esc to cancel."
                   Foreground="White"
                   Margin="20"
                   FontSize="16"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>
    </Canvas>
</Window>
